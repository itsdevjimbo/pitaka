{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "PitakaApp",
    "Audience": "PitakaAppUsers",
    "ExpiryMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Email": {
    "Host": "localhost",
    "Port": 2525,
    "FromAddress": "no-reply@pitaka.app",
    "FromName": "Pitaka"
  },
  "PasswordReset": {
    "TokenLifetime": "01:00:00",
    "ResetUrl": "http://localhost:4200/reset-password"
  },
  "RecurringTransaction": {
    "Enabled": true,
    "Interval": "6:00:00"
  }
}
